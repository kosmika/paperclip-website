---
import { Font } from 'astro:assets';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://paperclip.ing');

const {
  title = 'Paperclip – The app people use to manage AI agents for work',
  description = 'Manage a team of AI agents to run your business. Org charts, budgets, governance, and goals — all in one deployment.',
  ogImage = '/og-v3.jpg',
} = Astro.props;

const ogImageURL = new URL(ogImage, canonicalURL.origin).href;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL.href} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="537" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Fonts (self-hosted via astro:assets, with optimized fallbacks to prevent layout shift) -->
    <Font cssVariable="--font-inter-tight" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" />

    <!-- Prevent FOUC on theme load -->
    <script is:inline>
      (function() {
        var t = localStorage.getItem('paperclip-theme') || 'dark';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body>
    <ThemeToggle />
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
