---
interface Props {
  title?: string;
  description?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://paperclip.ing');

const {
  title = 'Paperclip — Brand & Design System',
  description = 'The Paperclip Design System. One token model spanning the marketing site and product surfaces. Colors, typography, components, motion, and tokens.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light" data-density="comfortable">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL.href} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@500;600;700&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&family=Fraunces:opsz,wght@9..144,400;9..144,500&family=DM+Serif+Display&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('pds-theme') || 'light';
          var d = localStorage.getItem('pds-density') || 'comfortable';
          document.documentElement.setAttribute('data-theme', t);
          document.documentElement.setAttribute('data-density', d);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
    <script is:inline src="/brand/app.js" defer></script>
    <script is:inline src="/brand/generator.js" defer></script>
    <script is:inline src="/brand/sections.js" defer></script>
  </body>
</html>

<style is:global>
  @import '../styles/brand.css';
</style>
