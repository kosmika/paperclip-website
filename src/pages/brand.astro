---
import BrandLayout from '../layouts/BrandLayout.astro';
import Header from '../components/brand/Header.astro';
import TocAside from '../components/brand/TocAside.astro';
import Footer from '../components/Footer.astro';

import s01 from '../components/brand/sections/01-foundations.html?raw';
import s02 from '../components/brand/sections/02-logo.html?raw';
import s03 from '../components/brand/sections/03-typography.html?raw';
import s04 from '../components/brand/sections/04-color.html?raw';
import s05 from '../components/brand/sections/05-spacing.html?raw';
import s06 from '../components/brand/sections/06-radius.html?raw';
import s07 from '../components/brand/sections/07-iconography.html?raw';
import s08 from '../components/brand/sections/08-imagery.html?raw';
import s09 from '../components/brand/sections/09-voice.html?raw';
import s10 from '../components/brand/sections/10-motion.html?raw';
import s11 from '../components/brand/sections/11-components.html?raw';
import s12 from '../components/brand/sections/12-dataviz.html?raw';
import s13 from '../components/brand/sections/13-states.html?raw';
import s14 from '../components/brand/sections/14-tokens.html?raw';

const sections = [s01, s02, s03, s04, s05, s06, s07, s08, s09, s10, s11, s12, s13, s14];
---

<BrandLayout>
  <Header />

  <div id="nav-backdrop" class="nav-backdrop" hidden aria-hidden="true"></div>

  <button id="theme-toggle" class="header-btn" type="button" aria-label="Toggle theme">
    <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
  </button>

  <div class="layout" id="top">
    <TocAside />

    <main class="main">
      <section class="hero" id="hero">
        <div class="hero-grid">
          <div class="hero-text">
            <div class="eyebrow"><span class="eyebrow-num">v1.0</span><span class="eyebrow-line"></span><span class="eyebrow-label">DESIGN SYSTEM</span></div>
            <h1 class="display-1">The Paperclip Design System</h1>
            <p class="lede">One token model, two surfaces. The same colors, type, and motion power the marketing site, the product, and every artifact in between. Direct. Confident. Never decorative.</p>
            <div class="hero-cta">
              <a href="#foundations" class="btn btn-primary">Start reading</a>
              <a href="#tokens" class="btn btn-secondary" style="border-radius:10px">Jump to tokens</a>
              <a href="/brand/versions/v0.13.html" class="btn btn-ghost">v0.13 archive →</a>
            </div>
          </div>
          <aside class="hero-aside">
            <div class="hero-card">
              <div class="hero-card-row"><span class="hc-k">Status</span><span class="hc-v"><span class="status-dot status-dot--live"></span> Active</span></div>
              <div class="hero-card-row"><span class="hc-k">Version</span><span class="hc-v">v1.0</span></div>
              <div class="hero-card-row"><span class="hc-k">Released</span><span class="hc-v">May 2026</span></div>
              <div class="hero-card-row"><span class="hc-k">Surfaces</span><span class="hc-v">brand · product</span></div>
              <div class="hero-card-row"><span class="hc-k">Themes</span><span class="hc-v">light · dark</span></div>
              <div class="hero-card-row"><span class="hc-k">Stack</span><span class="hc-v">Astro · React · Tailwind</span></div>
            </div>
          </aside>
        </div>
      </section>

      {sections.map((html) => <Fragment set:html={html} />)}
    </main>
  </div>

  <Footer />
</BrandLayout>
