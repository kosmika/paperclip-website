<style>
  .navbar {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
    transition: background 300ms ease-out, border-color 300ms ease-out;
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-md);
  }

  .navbar-left,
  .navbar-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex: 1;
  }

  .navbar-left {
    justify-content: flex-start;
  }

  .navbar-right {
    justify-content: flex-end;
  }

  .navbar-logo {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: 'Inter Tight', sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink-t);
    white-space: nowrap;
  }

  .navbar-link {
    font-size: 0.85rem;
    font-weight: 450;
    color: var(--mono);
    transition: color var(--t-micro) ease;
  }

  .navbar-link:hover {
    color: var(--ink-t);
  }

  .navbar-link--icon {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .navbar-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--bg);
    background: var(--ink-t);
    padding: 0.45rem 1rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--ink-t);
    transition:
      background var(--t-short) var(--ease-enter),
      color var(--t-short) var(--ease-enter),
      border-color var(--t-short) var(--ease-enter);
  }

  .navbar-cta:hover {
    background: var(--bond);
    color: var(--ink);
    border-color: var(--bond);
  }

  :global([data-theme="light"]) .navbar-cta:hover {
    border-color: var(--ink);
  }

  :global([data-theme="dark"]) .navbar-cta {
    color: var(--charcoal);
    background: var(--cream);
    border-color: var(--cream);
  }

  :global([data-theme="dark"]) .navbar-cta:hover {
    background: transparent;
    color: var(--cream);
    border-color: var(--cream);
  }

  .navbar-cta-count {
    font-size: 0.75rem;
    font-weight: 600;
    opacity: 0.7;
    margin-left: 0.1rem;
  }

  @media (max-width: 768px) {
    .navbar-inner {
      height: 52px;
    }

    .navbar-left,
    .navbar-right {
      gap: 1rem;
    }

    .navbar-link {
      font-size: 0.8rem;
    }

    .navbar-cta {
      font-size: 0.75rem;
      padding: 0.35rem 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .navbar-link--secondary,
    .navbar-link--icon {
      display: none;
    }

    .navbar-cta {
      font-size: 0.7rem;
      padding: 0.3rem 0.6rem;
      gap: 0.25rem;
    }

    .navbar-cta svg {
      width: 11px;
      height: 11px;
    }
  }
</style>
