        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
    </div>
    <a href="/" class="navbar-logo">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="m16 6-8.414 8.586a2 2 0 0 0 2.829 2.829l8.414-8.586a4 4 0 1 0-5.657-5.657l-8.379 8.551a6 6 0 1 0 8.485 8.485l8.379-8.551" />
      </svg>
      <span>Paperclip</span>
    </a>
    <div class="navbar-right">
      <a href="https://github.com/paperclipai/paperclip" class="navbar-cta">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        Star<span class="navbar-cta-count" data-star-count hidden></span>
      </a>
    </div>
  </div>
</nav>

<script is:inline>
  (function () {
    var REPO = 'paperclipai/paperclip';
    var CACHE_KEY = 'paperclip-star-count';
    var TTL_MS = 5 * 60 * 1000; // 5 minutes

    function format(count) {
      if (typeof count !== 'number' || count <= 0) return '';
      return count >= 1000
        ? (count / 1000).toFixed(1).replace(/\.0$/, '') + 'k'
        : String(count);
    }

    function render(text) {
      if (!text) return;
      document.querySelectorAll('[data-star-count]').forEach(function (el) {
        el.textContent = text;
        el.hidden = false;
      });
    }

    // Render cached value immediately if present (avoids flash on subsequent loads)
    try {
      var raw = localStorage.getItem(CACHE_KEY);
      if (raw) {
        var cached = JSON.parse(raw);
        if (cached && typeof cached.count === 'number') {
          render(format(cached.count));
          if (cached.ts && Date.now() - cached.ts < TTL_MS) return; // fresh, skip fetch
        }
      }
    } catch (_) {}

    fetch('https://api.github.com/repos/' + REPO, {
      headers: { 'Accept': 'application/vnd.github.v3+json' },
    })
      .then(function (res) { return res.ok ? res.json() : null; })
      .then(function (data) {
        if (!data || typeof data.stargazers_count !== 'number') return;
        render(format(data.stargazers_count));
        try {
          localStorage.setItem(CACHE_KEY, JSON.stringify({
            count: data.stargazers_count,
            ts: Date.now(),
          }));
        } catch (_) {}
      })
      .catch(function () { /* silently fail */ });
  })();
</script>

<style>
  .navbar {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
    transition: background 300ms ease-out, border-color 300ms ease-out;
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-md);
  }

  .navbar-left,
  .navbar-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex: 1;
  }

  .navbar-left {
    justify-content: flex-start;
  }

  .navbar-right {
    justify-content: flex-end;
  }

  .navbar-logo {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink-t);
    white-space: nowrap;
  }

  .navbar-link {
    font-size: 0.85rem;
    font-weight: 450;
    color: var(--mono);
    transition: color var(--t-micro) ease;
  }

  .navbar-link:hover {
    color: var(--ink-t);
  }

  .navbar-link--icon {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .navbar-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--bg);
    background: var(--ink-t);
    padding: 0.45rem 1rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--ink-t);
    transition:
      background var(--t-short) var(--ease-enter),
      color var(--t-short) var(--ease-enter),
      border-color var(--t-short) var(--ease-enter);
  }

  .navbar-cta:hover {
    background: var(--bond);
    color: var(--ink);
    border-color: var(--bond);
  }

  :global([data-theme="light"]) .navbar-cta:hover {
    border-color: var(--ink);
  }

  :global([data-theme="dark"]) .navbar-cta {
    color: var(--charcoal);
    background: var(--cream);
    border-color: var(--cream);
  }

  :global([data-theme="dark"]) .navbar-cta:hover {
    background: transparent;
    color: var(--cream);
    border-color: var(--cream);
  }

  .navbar-cta-count {
    font-size: 0.75rem;
    font-weight: 600;
    opacity: 0.7;
    margin-left: 0.1rem;
  }

  @media (max-width: 768px) {
    .navbar-inner {
      height: 52px;
    }

    .navbar-left,
    .navbar-right {
      gap: 1rem;
    }

    .navbar-link {
      font-size: 0.8rem;
    }

    .navbar-cta {
      font-size: 0.75rem;
      padding: 0.35rem 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .navbar-link--secondary,
    .navbar-link--icon {
      display: none;
    }

    .navbar-cta {
      font-size: 0.7rem;
      padding: 0.3rem 0.6rem;
      gap: 0.25rem;
    }

    .navbar-cta svg {
      width: 11px;
      height: 11px;
    }
  }
</style>
