---
import Terminal from './Terminal.astro';
---

<section id="get-started" class="cta-section">
  <div class="container cta-inner">
    <span class="section-badge section-badge--g12 cta-badge">Get started</span>
    <h2 class="cta-heading">Hire a team of agents<br />in one command.</h2>
    <div class="cta-terminal">
      <Terminal />
    </div>
    <p class="cta-sub">
      Open source. Self-hosted. Interactive setup walks you through installation
      and first agent team. No Paperclip account required. No agents installed automatically.
    </p>
    <div class="cta-links">
      <a href="https://github.com/paperclipai/paperclip" class="cta-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        Star on GitHub
      </a>
      <a href="https://docs.paperclip.ing" class="cta-link">Read the docs &rarr;</a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    background: #f5f3f0;
    padding: var(--space-3xl) 0;
    text-align: center;
  }

  :global([data-theme="dark"]) .cta-section {
    background: var(--surface);
  }

  :global([data-theme="dark"]) .cta-section .cta-heading {
    color: var(--ink-t);
  }

  :global([data-theme="dark"]) .cta-section .cta-sub {
    color: var(--mono);
  }

  :global([data-theme="dark"]) .cta-section .cta-link {
    color: var(--mono);
  }

  :global([data-theme="dark"]) .cta-section .cta-link:hover {
    color: var(--ink-t);
  }

  .cta-inner {
    max-width: 660px;
  }

  .cta-heading {
    font-family: 'Inter Tight', sans-serif;
    font-size: clamp(32px, 4vw, 56px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--ink-t);
    padding-bottom: 20px;
    margin-bottom: var(--space-lg);
  }

  .cta-terminal {
    max-width: 420px;
    margin: 0 auto var(--space-xl);
  }

  .cta-sub {
    color: var(--mono);
    font-size: 0.9rem;
    line-height: 1.7;
    max-width: 480px;
    margin: 0 auto var(--space-lg);
  }

  .cta-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  /* Primary CTA — ink pill on light; cream pill on dark (matches hero) */
  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.7rem 1.4rem;
    border-radius: var(--r-pill);
    transition:
      background var(--t-short) var(--ease-enter),
      color var(--t-short) var(--ease-enter),
      border-color var(--t-short) var(--ease-enter);
  }

  :global([data-theme="light"]) .cta-btn {
    color: var(--bg);
    background: var(--ink-t);
    border: 1px solid var(--ink-t);
  }

  :global([data-theme="light"]) .cta-btn:hover {
    background: var(--bond);
    color: var(--ink);
    border-color: var(--ink);
  }

  :global([data-theme="dark"]) .cta-btn {
    color: var(--charcoal);
    background: var(--cream);
    border: 1px solid var(--cream);
  }

  :global([data-theme="dark"]) .cta-btn:hover {
    background: var(--charcoal);
    color: var(--cream);
    border-color: var(--charcoal);
  }

  .cta-link {
    font-size: 0.9rem;
    color: var(--mono);
    transition: color var(--t-micro) ease;
  }

  .cta-link:hover {
    color: var(--ink-t);
  }
</style>
