---
---

<footer class="footer" data-theme="dark">
  <div class="footer-wordmark-row container">
    <span class="footer-wordmark">Paperclip</span>
  </div>

  <div class="footer-columns container">
    <div class="footer-col">
      <h4 class="footer-col-heading">Product</h4>
      <a href="/#get-started">Get started</a>
      <a href="/#get-started">Quickstart</a>
    </div>
    <div class="footer-col">
      <h4 class="footer-col-heading">Platform</h4>
      <a href="/#orgchart-section">Agents</a>
      <a href="/#governance-section">Governance</a>
      <a href="/#orgchart-section">Integrations</a>
    </div>
    <div class="footer-col">
      <h4 class="footer-col-heading">Developers</h4>
      <a href="https://docs.paperclip.ing">Documentation</a>
      <a href="https://docs.paperclip.ing">API reference</a>
      <a href="https://github.com/paperclipai/paperclip">GitHub</a>
    </div>
    <div class="footer-col">
      <h4 class="footer-col-heading">Resources</h4>
      <a href="/blog">Blog</a>
      <a href="/changelog">Changelog</a>
      <a href="https://github.com/paperclipai/paperclip">Contributing</a>
      <a href="https://github.com/paperclipai/paperclip">License</a>
      <a href="https://discord.gg/m4HZY7xNG3">Discord</a>
    </div>
  </div>

  <div class="footer-bottom container">
    <span class="footer-copy">&copy; {new Date().getFullYear()} Paperclip. Open source under MIT.</span>
    <div class="footer-bottom-links">
      <a href="/tos#privacy">Privacy</a>
      <a href="/tos">Terms</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg);
    border-top: 1px solid var(--rule);
  }

  .footer-wordmark-row {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .footer-wordmark {
    font-family: 'Inter Tight', sans-serif;
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--ink-t);
    display: block;
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .footer-col-heading {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-t);
    margin-bottom: 0.75rem;
    letter-spacing: 0.01em;
  }

  .footer-col a {
    display: block;
    font-size: 0.875rem;
    color: var(--mono);
    padding: 0.2rem 0;
    transition: color var(--t-micro) ease;
  }

  .footer-col a:hover {
    color: var(--ink-t);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding-top: var(--space-md);
    padding-bottom: var(--space-md);
    border-top: 1px solid var(--rule);
  }

  .footer-copy {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--mono);
  }

  .footer-bottom-links {
    display: flex;
    gap: var(--space-md);
  }

  .footer-bottom-links a {
    font-size: 0.8rem;
    color: var(--mono);
    transition: color var(--t-micro) ease;
  }

  .footer-bottom-links a:hover {
    color: var(--ink-t);
  }

  @media (max-width: 768px) {
    .footer-columns {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-lg) var(--space-md);
    }
  }

  @media (max-width: 480px) {
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
