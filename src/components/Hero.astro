---
---

<section class="hero">
  <div class="container hero-inner">
    <h1 class="hero-headline">
      Paperclip<br />The human control plane<br />for AI labor
    </h1>
    <p class="hero-lede">
      Hire AI employees, set goals, automate jobs <span class="nowrap">and your business runs itself.</span>
    </p>
    <div class="hero-actions">
      <a href="#get-started" class="hero-btn-primary">Get started</a>
      <a href="https://github.com/paperclipai/paperclip" class="hero-btn-secondary">
        GitHub
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--bg);
    padding: clamp(5rem, 10vw, 10rem) 0 clamp(4rem, 8vw, 8rem);
    transition: background 300ms ease-out;
  }

  .hero-inner {
    max-width: 900px;
    text-align: center;
  }

  .hero-headline {
    font-family: 'Inter Tight', sans-serif;
    font-size: clamp(48px, 7.5vw, 104px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.98;
    color: var(--ink-t);
    margin-bottom: 1.5rem;
  }

  .hero-lede {
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: var(--mono);
    max-width: 520px;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
  }

  .nowrap {
    white-space: nowrap;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  /* Primary CTA — pill, ink bg */
  .hero-btn-primary {
    display: inline-block;
    font-size: 0.95rem;
    font-weight: 500;
    padding: 0.8rem 2rem;
    background: var(--ink-t);
    color: var(--bg);
    border: 1px solid var(--ink-t);
    border-radius: var(--r-pill);
    transition:
      background var(--t-short) var(--ease-enter),
      color var(--t-short) var(--ease-enter),
      border-color var(--t-short) var(--ease-enter);
  }

  .hero-btn-primary:hover {
    background: var(--bond);
    color: var(--ink);
    border-color: var(--bond);
  }

  :global([data-theme="dark"]) .hero-btn-primary {
    background: var(--cream);
    color: var(--charcoal);
    border-color: var(--cream);
  }

  :global([data-theme="dark"]) .hero-btn-primary:hover {
    background: transparent;
    color: var(--cream);
    border-color: var(--cream);
  }

  /* Secondary CTA — 8px rect, transparent */
  .hero-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.95rem;
    padding: 0.8rem 2rem;
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    color: var(--mono);
    transition: color var(--t-short) ease, border-color var(--t-short) ease;
  }

  .hero-btn-secondary:hover {
    color: var(--ink-t);
    border-color: var(--ink-t);
  }

  @media (max-width: 768px) {
    .hero {
      padding: clamp(4rem, 8vw, 6rem) 0 clamp(3rem, 6vw, 5rem);
    }
  }
</style>
