---
import fs from 'node:fs';
import { fileURLToPath } from 'node:url';

// Inline the hero gradient SVGs so the embedded feTurbulence noise filter
// rasterizes at the device pixel ratio (sharp on retina). When loaded as
// <img>, browsers rasterize the SVG — including filter primitives — at
// the SVG's intrinsic CSS size and then upscale, which makes the dither
// look blurry on 2x+ displays.
const publicDir = fileURLToPath(new URL('../../public/', import.meta.url));
const desktopSvgRaw = fs.readFileSync(`${publicDir}paperclip_blendRow_1230631627_1200x675.svg`, 'utf-8');
const mobileSvgRaw = fs.readFileSync(`${publicDir}paperclip_blendRow_1200x675-fine.svg`, 'utf-8');

// Both SVGs reuse the same internal IDs (g0..g44, ditherN, ditherMask, pc-caps).
// With both inlined in the same document the second copy would otherwise steal
// gradients/masks from the first, so namespace one of them.
function namespaceSvgIds(svg: string, prefix: string): string {
  return svg
    .replace(/\bid="([^"]+)"/g, `id="${prefix}$1"`)
    .replace(/\burl\(#([^)]+)\)/g, `url(#${prefix}$1)`)
    .replace(/\bhref="#([^"]+)"/g, `href="#${prefix}$1"`)
    .replace(/\bxlink:href="#([^"]+)"/g, `xlink:href="#${prefix}$1"`);
}

const desktopSvg = desktopSvgRaw;
const mobileSvg = namespaceSvgIds(mobileSvgRaw, 'm-');
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-bg-svg hero-bg-svg-desktop" set:html={desktopSvg} />
    <div class="hero-bg-svg hero-bg-svg-mobile" set:html={mobileSvg} />
  </div>
  <div class="container hero-inner">
    <h1 class="hero-headline">
      A team of agents<br />for every person.
    </h1>
    <p class="hero-lede">
      Paperclip is the app people use<br />to manage AI agents for work.
    </p>
    <div class="hero-actions">
      <a href="#get-started" class="hero-btn-primary">Get started</a>
      <a href="https://github.com/paperclipai/paperclip" class="hero-btn-secondary">
        GitHub
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(5rem, 10vw, 10rem) 0 clamp(4rem, 8vw, 8rem);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    --hero-bg-y: -310px;
    transform: translateY(var(--hero-bg-y));
    will-change: transform;
  }

  /* Wrapper around each inlined SVG. `display: contents` lets the inner <svg>
     act as the direct flex child of .hero-bg so the existing centering works. */
  .hero-bg-svg {
    display: contents;
  }

  .hero-bg-svg-mobile {
    display: none;
  }

  /* Inlined SVGs are injected via `set:html` and don't receive Astro's
     scoping attribute, so selectors targeting them must use :global(svg).
     flex-shrink: 0 stops the parent flex container from squeezing the
     SVG below its declared width (needed on mobile where the SVG is
     wider than the viewport and is meant to overflow). */
  .hero-bg :global(svg) {
    display: block;
    width: min(1200px, 100%);
    height: auto;
    flex-shrink: 0;
    opacity: 0;
    transform: translateY(-24px);
    animation: heroBgEnter 1100ms var(--ease-enter, cubic-bezier(0.22, 1, 0.36, 1)) 80ms both;
    will-change: transform, opacity;
  }

  /* Light mode: soften the hero SVG so the dark H1 reads cleanly. */
  /* Desaturate the vivid stops, lift the dark navy/purple, and ease overall contrast. */
  :global([data-theme="light"]) .hero-bg :global(svg) {
    filter: saturate(1) brightness(1) contrast(1);
  }

  /* Light mode: soft white veil behind the headline that further mutes */
  /* the SVG colors where the H1 sits. Sits between .hero-bg (z:0) and .hero-inner (z:1). */
  :global([data-theme="light"]) .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 50% 25% at 50% 50%,
      rgba(255, 255, 255, 0.8) 0%,
      rgba(255, 255, 255, 0.5) 45%,
      rgba(255, 255, 255, 0) 78%
    );
  }

  @keyframes heroBgEnter {
    from {
      opacity: 0;
      transform: translateY(-24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-headline,
  .hero-lede {
    opacity: 0.55;
    transform: translateY(18px);
    animation: heroHeadlineEnter 900ms var(--ease-enter, cubic-bezier(0.22, 1, 0.36, 1)) 220ms both;
    will-change: transform, opacity;
  }

  @keyframes heroHeadlineEnter {
    from {
      opacity: 0.55;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Primary parallax path: compositor-driven scroll-linked animation.
     Runs smoothly during iOS momentum scrolling because no JS listener
     is involved. Browsers without support fall through to the JS path
     below (gated to fine-pointer devices). */
  @supports (animation-timeline: scroll()) {
    .hero {
      view-timeline-name: --hero-timeline;
      view-timeline-axis: block;
    }

    .hero-bg {
      animation: heroBgParallax linear both;
      animation-timeline: --hero-timeline;
      animation-range: exit;
    }

    .hero-inner {
      animation: heroInnerParallax linear both;
      animation-timeline: --hero-timeline;
      animation-range: exit;
    }

    @keyframes heroBgParallax {
      from {
        transform: translateY(var(--hero-bg-y));
      }
      to {
        transform: translateY(calc(var(--hero-bg-y) - 15vh));
      }
    }

    @keyframes heroInnerParallax {
      from {
        transform: translateY(0);
      }
      to {
        transform: translateY(-45vh);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg,
    .hero-inner,
    .hero-headline,
    .hero-lede {
      will-change: auto;
    }

    .hero-bg,
    .hero-inner {
      animation: none;
    }

    .hero-inner {
      transform: none;
    }

    .hero-bg :global(svg) {
      will-change: auto;
      opacity: 1;
      transform: none;
      animation: none;
    }

    .hero-headline,
    .hero-lede {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
    text-align: center;
    --hero-inner-y: 0px;
    transform: translateY(var(--hero-inner-y));
    will-change: transform;
  }

  .hero-headline {
    font-family: var(--font-serif);
    font-size: 60px;
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.98;
    color: var(--ink-t);
    margin-top: 124px;
    margin-bottom: 1.5rem;
  }

  .hero-lede {
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: var(--mono);
    max-width: 520px;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  /* Primary CTA — pill, ink bg */
  .hero-btn-primary {
    display: inline-block;
    font-size: 0.95rem;
    font-weight: 500;
    padding: 0.8rem 2rem;
    background: var(--ink-t);
    color: var(--bg);
    border: 1px solid var(--ink-t);
    border-radius: var(--r-pill);
    transition:
      background var(--t-short) var(--ease-enter),
      color var(--t-short) var(--ease-enter),
      border-color var(--t-short) var(--ease-enter);
  }

  .hero-btn-primary:hover {
    background: var(--bond);
    color: var(--ink);
    border-color: var(--bond);
  }

  :global([data-theme="light"]) .hero-btn-primary:hover {
    border-color: var(--ink);
  }

  :global([data-theme="dark"]) .hero-btn-primary {
    background: var(--cream);
    color: var(--charcoal);
    border-color: var(--cream);
  }

  :global([data-theme="dark"]) .hero-btn-primary:hover {
    background: transparent;
    color: var(--cream);
    border-color: var(--cream);
  }

  /* Secondary CTA — 8px rect, transparent */
  .hero-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.95rem;
    padding: 0.8rem 2rem;
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    color: var(--mono);
    transition: color var(--t-short) ease, border-color var(--t-short) ease;
  }

  .hero-btn-secondary:hover {
    color: var(--ink-t);
    border-color: var(--ink-t);
  }

  @media (max-width: 768px) {
    .hero {
      padding: clamp(4rem, 8vw, 6rem) 0 clamp(3rem, 6vw, 5rem);
    }

    .hero-bg {
      /* Positions the SVG so the capsule bottoms partially clip the
         top of the H1's first line, mirroring the desktop crop. */
      --hero-bg-y: -220px;
    }

    .hero-bg-svg-desktop {
      display: none;
    }

    .hero-bg-svg-mobile {
      display: contents;
    }

    /* 155vw makes the capsule cluster (~47% of SVG width) roughly match
       the width of the H1's first line on a typical mobile viewport. */
    .hero-bg :global(svg) {
      width: min(1200px, 150vw);
    }

    .hero-headline {
      font-size: clamp(2.25rem, 11.5vw, 3.75rem);
      margin-top: clamp(4.5rem, 20vw, 6.5rem);
    }
  }
</style>

<script>
  const HERO_BG_PARALLAX_RATE = 0.15;
  const HERO_INNER_PARALLAX_RATE = 0.35;
  const mobileMq = window.matchMedia('(max-width: 768px)');

  function getHeroBgBaseY() {
    return mobileMq.matches ? -220 : -310;
  }

  let teardownHeroParallax: (() => void) | undefined;

  function initHeroParallax() {
    teardownHeroParallax?.();

    const hero = document.querySelector('.hero');
    const bg = hero?.querySelector('.hero-bg');
    const inner = hero?.querySelector('.hero-inner');
    if (!(hero instanceof HTMLElement) || !(bg instanceof HTMLElement) || !(inner instanceof HTMLElement)) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reducedMotion) {
      bg.style.setProperty('--hero-bg-y', `${getHeroBgBaseY()}px`);
      inner.style.setProperty('--hero-inner-y', '0px');
      return;
    }

    let ticking = false;

    const update = () => {
      const scrolled = Math.max(0, -hero.getBoundingClientRect().top);
      const bgY = getHeroBgBaseY() - scrolled * HERO_BG_PARALLAX_RATE;
      const innerY = -scrolled * HERO_INNER_PARALLAX_RATE;
      bg.style.setProperty('--hero-bg-y', `${bgY}px`);
      inner.style.setProperty('--hero-inner-y', `${innerY}px`);
      ticking = false;
    };

    const requestUpdate = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    const onMqChange = () => requestUpdate();

    update();
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
    mobileMq.addEventListener('change', onMqChange);

    teardownHeroParallax = () => {
      window.removeEventListener('scroll', requestUpdate);
      window.removeEventListener('resize', requestUpdate);
      mobileMq.removeEventListener('change', onMqChange);
    };
  }

  // Fallback path: only run the JS-driven parallax on browsers that lack
  // scroll-driven animations (e.g. Firefox as of 2026) AND on devices with
  // a fine pointer. Skipping it on touch devices avoids the choppy effect
  // caused by iOS Safari throttling `scroll` events during momentum scroll.
  const supportsScrollTimeline =
    typeof CSS !== 'undefined' && CSS.supports('animation-timeline', 'scroll()');
  const fineHoverMq = window.matchMedia('(hover: hover) and (pointer: fine)');

  function maybeInitHeroParallax() {
    if (supportsScrollTimeline || !fineHoverMq.matches) {
      teardownHeroParallax?.();
      teardownHeroParallax = undefined;
      return;
    }
    initHeroParallax();
  }

  maybeInitHeroParallax();
  fineHoverMq.addEventListener('change', maybeInitHeroParallax);
  document.addEventListener('astro:page-load', maybeInitHeroParallax);
</script>
