---
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <img src="/paperclip_blendRow_1230631627_1200x675.svg" alt="" width="1200" height="675" decoding="async" fetchpriority="high" />
  </div>
  <div class="container hero-inner">
    <h1 class="hero-headline">
      A team of agents<br />for every person.
    </h1>
    <p class="hero-lede">
      Paperclip is the app people use<br />to manage AI agents for work.
    </p>
    <div class="hero-actions">
      <a href="#get-started" class="hero-btn-primary">Get started</a>
      <a href="https://github.com/paperclipai/paperclip" class="hero-btn-secondary">
        GitHub
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(5rem, 10vw, 10rem) 0 clamp(4rem, 8vw, 8rem);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-bg img {
    display: block;
    width: auto;
    height: auto;
    max-width: min(1200px, 100%);
    max-height: 100%;
    object-fit: contain;
    --hero-bg-y: -250px;
    transform: translateY(var(--hero-bg-y));
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg img {
      will-change: auto;
    }
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
    text-align: center;
  }

  .hero-headline {
    font-family: 'Inter Tight', sans-serif;
    font-size: 60px;
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.98;
    color: var(--ink-t);
    margin-top: 124px;
    margin-bottom: 1.5rem;
  }

  .hero-lede {
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: var(--mono);
    max-width: 520px;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  /* Primary CTA — pill, ink bg */
  .hero-btn-primary {
    display: inline-block;
    font-size: 0.95rem;
    font-weight: 500;
    padding: 0.8rem 2rem;
    background: var(--ink-t);
    color: var(--bg);
    border: 1px solid var(--ink-t);
    border-radius: var(--r-pill);
    transition:
      background var(--t-short) var(--ease-enter),
      color var(--t-short) var(--ease-enter),
      border-color var(--t-short) var(--ease-enter);
  }

  .hero-btn-primary:hover {
    background: var(--bond);
    color: var(--ink);
    border-color: var(--bond);
  }

  :global([data-theme="light"]) .hero-btn-primary:hover {
    border-color: var(--ink);
  }

  :global([data-theme="dark"]) .hero-btn-primary {
    background: var(--cream);
    color: var(--charcoal);
    border-color: var(--cream);
  }

  :global([data-theme="dark"]) .hero-btn-primary:hover {
    background: transparent;
    color: var(--cream);
    border-color: var(--cream);
  }

  /* Secondary CTA — 8px rect, transparent */
  .hero-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.95rem;
    padding: 0.8rem 2rem;
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    color: var(--mono);
    transition: color var(--t-short) ease, border-color var(--t-short) ease;
  }

  .hero-btn-secondary:hover {
    color: var(--ink-t);
    border-color: var(--ink-t);
  }

  @media (max-width: 768px) {
    .hero {
      padding: clamp(4rem, 8vw, 6rem) 0 clamp(3rem, 6vw, 5rem);
    }
  }
</style>

<script>
  const HERO_BG_BASE_Y = -250;
  const HERO_BG_PARALLAX_RATE = 0.35;

  let teardownHeroBgParallax: (() => void) | undefined;

  function initHeroBgParallax() {
    teardownHeroBgParallax?.();

    const hero = document.querySelector('.hero');
    const img = hero?.querySelector('.hero-bg img');
    if (!(hero instanceof HTMLElement) || !(img instanceof HTMLImageElement)) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reducedMotion) {
      img.style.setProperty('--hero-bg-y', `${HERO_BG_BASE_Y}px`);
      return;
    }

    let ticking = false;

    const update = () => {
      const scrolled = Math.max(0, -hero.getBoundingClientRect().top);
      const y = HERO_BG_BASE_Y - scrolled * HERO_BG_PARALLAX_RATE;
      img.style.setProperty('--hero-bg-y', `${y}px`);
      ticking = false;
    };

    const requestUpdate = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    update();
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });

    teardownHeroBgParallax = () => {
      window.removeEventListener('scroll', requestUpdate);
      window.removeEventListener('resize', requestUpdate);
    };
  }

  initHeroBgParallax();
  document.addEventListener('astro:page-load', initHeroBgParallax);
</script>
